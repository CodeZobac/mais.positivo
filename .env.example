# Copia este ficheiro para .env.local e preenche a chave.
# Chave criada em https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Opcional: modelo do DeepSeek a usar (por omissão, deepseek-flash).
# DEEPSEEK_MODEL=deepseek-flash

# Opcional: observabilidade com Langfuse (custos por utilizador, alertas).
# Sem estas chaves, nada é enviado. Chaves em https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
